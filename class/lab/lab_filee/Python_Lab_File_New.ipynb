     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "import matplotlib.pyplot as plt\n",
       "\n",
       "# Line plot\n",
       "x = [1, 2, 3, 4, 5]\n",
       "y = [2, 4, 6, 8, 10]\n",
       "plt.figure(figsize=(8, 4))\n",
