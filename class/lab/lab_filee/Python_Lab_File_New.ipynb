       "# 7. Implementation of NumPy and Seaborn"
      ]
     },
     {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
       "## 7.1 NumPy\n",
       "\n",
       "Let's explore basic NumPy operations."
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "import numpy as np\n",
       "\n",
       "# Creating arrays\n",
       "arr1 = np.array([1, 2, 3, 4, 5])\n",
       "arr2 = np.array([[1, 2, 3], [4, 5, 6]])\n",
       "\n",
       "print(\"1D Array:\")\n",
       "print(arr1)\n",
       "print(\"\\n2D Array:\")\n",
       "print(arr2)\n",
       "\n",
       "# Array operations\n",
       "print(\"\\nArray operations:\")\n",
       "print(f\"Sum: {np.sum(arr1)}\")\n",
       "print(f\"Mean: {np.mean(arr1)}\")\n",
       "print(f\"Max: {np.max(arr1)}\")\n",
       "print(f\"Min: {np.min(arr1)}\")\n",
       "\n",
       "# Array manipulation\n",
       "print(\"\\nArray manipulation:\")\n",
       "print(f\"Reshaped array: {arr1.reshape(5, 1)}\")\n",
       "print(f\"Transposed array: {arr2.T}\")\n",
       "print(f\"Flattened array: {arr2.flatten()}\")"
      ]
     },
     {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
       "## 7.2 Seaborn\n",
       "\n",
       "Let's explore basic Seaborn plotting."
      ]
     },
     {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
       "import seaborn as sns\n",
       "\n",
       "# Load sample dataset\n",
       "tips = sns.load_dataset('tips')\n",
       "\n",
       "# Scatter plot\n",
       "plt.figure(figsize=(8, 4))\n",
       "sns.scatterplot(data=tips, x='total_bill', y='tip')\n",
       "plt.title('Scatter Plot of Total Bill vs Tip')\n",
       "plt.show()\n",
       "\n",
       "# Box plot\n",
       "plt.figure(figsize=(8, 4))\n",
       "sns.boxplot(data=tips, x='day', y='total_bill')\n",
       "plt.title('Box Plot of Total Bill by Day')\n",
       "plt.show()\n",
       "\n",
       "# Histogram\n",
